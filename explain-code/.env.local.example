# Supabase Configuration
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Supabase Service Role Key (Keep this secret, NEVER expose to the client)
# Used by backend routes for student authentication and server-side evaluations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# Pepper string appended to student 4-digit PIN before authenticating with Supabase Auth
# Ensures student PIN passwords meet Supabase's minimum length requirement securely
SERVER_PEPPER=change_this_to_a_secure_random_pepper_secret_2026

# Invite code for instant teacher approval upon registration (otherwise teacher_status = 'pending')
TEACHER_INVITE_CODE=TEACHER2026

# Gemini API Key (Keep secret, NEVER expose to the client)
GEMINI_API_KEY=
